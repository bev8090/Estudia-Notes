PORT=5000
# Browser origins allowed to call the API, comma-separated (no trailing slash).
# Production example: https://estudia-notes.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000

# Supabase Postgres (Project Settings > Database > Connect > ORMs > Prisma)
# Pooled, transaction mode (port 6543): used by the app at runtime
DATABASE_URL=
# Direct / session mode (port 5432): used by the Prisma CLI for migrations
DIRECT_URL=

# Supabase Auth (Project Settings > API Keys). Publishable key only; never the secret key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Claude API key (platform.claude.com > Settings > API Keys)
ANTHROPIC_API_KEY=
# Optional: model for study guides, exams and grading (default claude-sonnet-5-5)
# AI_MODEL=claude-sonnet-5-5
# Optional: max notes + exams per user per 24 hours (default 30)
# DAILY_AI_LIMIT=30
